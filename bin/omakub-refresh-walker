#!/bin/bash

# omakub:summary=Overwrite the user configs for Walker (app launcher and Omabuntu Menu) and restart the services.

mkdir -p ~/.config/autostart/
cp $OMAKUB_PATH/default/walker/walker.desktop ~/.config/autostart/

# And restarts if it crashes or is killed
mkdir -p ~/.config/systemd/user/app-walker@autostart.service.d/
cp $OMAKUB_PATH/default/walker/restart.conf ~/.config/systemd/user/app-walker@autostart.service.d/restart.conf

systemctl --user daemon-reload

# Refresh configs
omakub-refresh-config walker/config.toml
omakub-refresh-config elephant/calc.toml
omakub-refresh-config elephant/desktopapplications.toml

# Link all elephant menus
mkdir -p ~/.config/elephant/menus
for menu in $OMAKUB_PATH/default/elephant/*.lua; do
  ln -snf "$menu" ~/.config/elephant/menus/"$(basename "$menu")"
done

# Restart service
omakub-restart-walker
