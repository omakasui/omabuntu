#!/bin/bash

# omakub:summary=Set the Plymouth boot theme from an Omabuntu theme
# omakub:args=<theme-name>
# omakub:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via omakub-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: omakub-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/omakub/themes/$theme ]]; then
  theme_dir=~/.config/omakub/themes/$theme
else
  theme_dir="$OMAKUB_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec omakub-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
