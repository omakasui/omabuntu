show_remove_menu() {
  case $(menu "Remove" "  Package\n  Web App\n  TUI\n  Style\n󰵮  Development\n󱚤  AI\n  Gaming\n󰏓  Preinstalls") in
  *Package*) terminal omakub-pkg-remove ;;
  *Web*) present_terminal omakub-webapp-remove ;;
  *TUI*) present_terminal omakub-tui-remove ;;
  *Style*) show_remove_style_menu ;;
  *Development*) show_remove_development_menu ;;
  *AI*) show_remove_ai_menu ;;
  *Gaming*) show_remove_gaming_menu ;;
  *Preinstalls*) present_terminal omakub-remove-preinstalls ;;
  *) show_main_menu ;;
  esac
}

show_remove_style_menu() {
  case $(menu "Remove" "󰸌  Theme\n  Font") in
  *Theme*) present_terminal omakub-theme-remove ;;
  *Font*) show_remove_font_menu ;;
  *) show_remove_menu ;;
  esac
}

show_remove_font_menu() {
  case $(menu "Remove Font" "  Cascadia Mono\n  JetBrains Mono\n  iA Fonts\n  Microsoft Core Fonts" "--width 350") in
