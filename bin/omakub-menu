#!/bin/bash

# omakub:summary=Launch the Omabuntu Menu or takes a parameter to jump straight to a submenu.

export PATH="$HOME/.local/share/omakub/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | omakub-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec "$@"
}

present_terminal() {
  omakub-launch-terminal-with-presentation "$@"
}

open_in_editor() {
  omakub-notification-send -g "󰂮" -u low "Editing config file" "$1"
  omakub-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; omakub-pkg-add $2"
}

install_font() {
  present_terminal "echo 'Installing $1...'; omakub-install-font $2 && sleep 2 && omakub-font-set '$3'"
}

install_terminal() {
  present_terminal "omakub-install-terminal $1"
}

remove() {
  present_terminal "echo 'Removing $1...'; omakub-pkg-drop $2"
}

remove_font() {
  present_terminal "echo 'Removing $1...'; omakub-remove-font $2"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Tmux keybindings\n  Omabuntu\n  Ubuntu\n󰊬  GNOME\n  Neovim\n󱆃  Bash") in
  *Keybindings*) omakub-launch-webapp "https://omabuntu.omakasui.org/manual/essentials/hotkeys" "Omabuntu Keybindings" ;;
  *Tmux*) omakub-menu-tmux-keybindings ;;
  *Omabuntu*) omakub-launch-webapp "https://omabuntu.omakasui.org/manual" "Omabuntu" ;;
  *Ubuntu*) omakub-launch-webapp "https://help.ubuntu.com/" "Ubuntu" ;;
  *GNOME*) omakub-launch-webapp "https://help.gnome.org/" "GNOME" ;;
  *Bash*) omakub-launch-webapp "https://devhints.io/bash" "Bash" ;;
  *Neovim*) omakub-launch-webapp "https://www.lazyvim.org/keymaps" "Neovim" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n󰧸  Transcode\n  Share\n󰔎  Toggle") in
  *Reminder*) show_reminder_menu ;;
  *Transcode*) omakub-transcode || back_to show_trigger_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) omakub-reminder show ;;
  *"Clear all"*) omakub-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(omakub-menu-input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    omakub-notification-send -g "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(omakub-menu-input "Reminder message")

  if [[ -n $message ]]; then
    omakub-reminder "$minutes" "$message"
  else
    omakub-reminder "$minutes"
  fi
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder\n󰥦  Receive") in
  *Receive*) localsend_app ;;
  *Clipboard*) omakub-menu-share clipboard ;;
  *File*) terminal bash -c "omakub-menu-share file" ;;
  *Folder*) terminal bash -c "omakub-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󰔎  Nightlight") in
  *Nightlight*) omakub-toggle-nightlight ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n󱣴  Plymouth\n  Font\n  Background\n  About") in
  *Theme*) show_theme_menu ;;
  *Plymouth*) omakub-launch-walker -m menus:omakubunlocks --width 800 --minheight 400 ;;
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *About*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  omakub-launch-walker -m menus:omakubthemes --width 800 --minheight 400
}

show_font_menu() {
  case $(menu "Font" "  Family\n󰧴  Size") in
  *Family*) show_font_family_menu ;;
  *Size*) present_terminal omakub-font-size-set ;;
  *) show_main_menu ;;
  esac
}

show_font_family_menu() {
  font=$(menu "Font" "$(omakub-font-list)" "--width 350" "$(omakub-font-current)")
  if [[ $font == "CNCLD" || -z $font ]]; then
    back_to show_style_menu
  else
    omakub-font-set "$font"
  fi
}

show_background_menu() {
  omakub-launch-walker -m menus:omakubBackgroundSelector --width 800 --minheight 400
}

show_about_menu() {
  case $(menu "About" "  Edit Text\n  Set From Image\n  Restore Default") in
  *Text*) omakub-branding-about text ;;
  *Image*) omakub-branding-about image ;;
  *Default*) omakub-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_setup_menu() {
  case $(menu "Setup" "󰤆  System Sleep\n  Folders\n  Keybindings\n󰓎  Defaults\n󰱔  DNS\n  Config") in
  *System*) show_setup_system_menu ;;
  *Folders*) show_setup_folders_menu ;;
  *Keybindings*) show_setup_keybindings_menu ;;
  *Defaults*) show_setup_default_menu ;;
  *DNS*) present_terminal omakub-setup-dns ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

 if omakub-toggle-enable suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  case $(menu "System" "$options") in
  *Suspend*) omakub-toggle-suspend ;;
  *) show_setup_menu ;;
  esac
}

show_setup_folders_menu() {
  case $(menu "Folders" "󰮝  Add\n󰮞  Remove") in
  *Add*) present_terminal omakub-gnome-grid-folder-add ;;
  *Remove*) present_terminal omakub-gnome-grid-folder-drop ;;
  *) show_setup_menu ;;
  esac
}

show_setup_keybindings_menu() {
  case $(menu "Keybindings" "   Add\n   Remove") in
  *Add*) present_terminal omakub-gnome-keybinding-add ;;
  *Remove*) present_terminal omakub-gnome-keybinding-drop ;;
  *) show_setup_menu ;;
  esac
}

show_setup_default_menu() {
  case $(menu "Default" "  Browser\n  Terminal\n  Editor") in
  *Browser*) show_setup_default_browser_menu ;;
  *Terminal*) show_setup_default_terminal_menu ;;
  *Editor*) show_setup_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}

show_setup_default_browser_menu() {
  local options=""
  browser_desktop_exists chromium.desktop && options="$options  Chromium"
  browser_desktop_exists google-chrome.desktop && options="${options:+$options\n}󰊯  Chrome"
  browser_desktop_exists brave-browser.desktop && options="${options:+$options\n}󰖟  Brave"
  browser_desktop_exists microsoft-edge.desktop && options="${options:+$options\n}󰇩  Edge"
  browser_desktop_exists firefox.desktop && options="${options:+$options\n}󰈹  Firefox"
  browser_desktop_exists zen.desktop && options="${options:+$options\n}󰖟  Zen"

  local current=""
  case "$(omakub-default-browser)" in
  chromium) current="  Chromium" ;;
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  esac

  case $(menu "Default Browser" "$options" "" "$current") in
  *Chromium*) omakub-default-browser chromium ;;
  *Chrome*) omakub-default-browser chrome ;;
  *Brave*) omakub-default-browser brave ;;
  *Edge*) omakub-default-browser edge ;;
  *Firefox*) omakub-default-browser firefox ;;
  *Zen*) omakub-default-browser zen ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_terminal_menu() {
  local options=""
  omakub-cmd-present alacritty && options="$options  Alacritty"
  omakub-cmd-present ghostty && options="${options:+$options\n}  Ghostty"
  omakub-cmd-present kitty && options="${options:+$options\n}  Kitty"

  local current=""
  case "$(omakub-default-terminal)" in
  alacritty) current="  Alacritty" ;;
  ghostty) current="  Ghostty" ;;
  kitty) current="  Kitty" ;;
  esac

  case $(menu "Default Terminal" "$options" "" "$current") in
  *Alacritty*) omakub-default-terminal alacritty ;;
  *Ghostty*) omakub-default-terminal ghostty ;;
  *Kitty*) omakub-default-terminal kitty ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_editor_menu() {
  local options=""
  omakub-cmd-present nvim && options="$options  Neovim"
  omakub-cmd-present code && options="${options:+$options\n}  VSCode"
  omakub-cmd-present cursor && options="${options:+$options\n}  Cursor"
  omakub-cmd-present zeditor && options="${options:+$options\n}  Zed"
  omakub-cmd-present vim && options="${options:+$options\n}  Vim"
  omakub-cmd-present emacs && options="${options:+$options\n}  Emacs"

  local current=""
  case "$(omakub-default-editor)" in
  nvim) current="  Neovim" ;;
  code) current="  VSCode" ;;
  cursor) current="  Cursor" ;;
  zed | zeditor) current="  Zed" ;;
  vim) current="  Vim" ;;
  emacs) current="  Emacs" ;;
  esac

  case $(menu "Default Editor" "$options" "" "$current") in
  *Neovim*) omakub-default-editor nvim ;;
  *VSCode*) omakub-default-editor code ;;
  *Cursor*) omakub-default-editor cursor ;;
  *Zed*) omakub-default-editor zed ;;
  *Vim*) omakub-default-editor vim ;;
  *Emacs*) omakub-default-editor emacs ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "󰌧  Walker\n󰞅  XCompose") in
  *Walker*) open_in_editor ~/.config/walker/config.toml && omakub-restart-walker ;;
  *XCompose*) open_in_editor ~/.XCompose && omakub-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

