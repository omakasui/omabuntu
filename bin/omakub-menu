show_update_menu() {
  local brand_name=$(omakub-brand)

  case $(menu "Update" "󰟢  $brand_name\n󰔫  Channel\n  Config\n󰸌  Themes\n  Process\n󰇅  Hardware\n  Firmware\n  Password") in
  *$brand_name*) present_terminal omakub-update ;;
  *Channel*) show_update_channel_menu ;;
  *Config*) show_update_config_menu ;;
  *Themes*) present_terminal omakub-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal omakub-update-firmware ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_channel_menu() {
  case $(menu "Update channel" "🟢 Stable\n🔴 Dev") in
  *Stable*) present_terminal "omakub-channel-set stable" ;;
  *Dev*) present_terminal "omakub-channel-set dev" ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Gnome\n󰍂  GDM\n  Keybindings\n󱣴  Plymouth\n  Starship\n  Tmux\n󰌧  Walker") in
  *Gnome*) present_terminal omakub-refresh-gnome ;;
  *GDM*) present_terminal omakub-refresh-gdm ;;
  *Keybindings*) present_terminal omakub-refresh-keybindings ;;
  *Plymouth*) present_terminal omakub-refresh-plymouth ;;
  *Starship*) present_terminal omakub-refresh-config starship.toml ;;
  *Tmux*) present_terminal omakub-refresh-tmux ;;
  *Walker*) present_terminal omakub-refresh-walker ;;
  *) show_update_menu ;;
  esac
}

show_update_process_menu() {
  case $(menu "Restart" "󰌧  Walker") in
  *Walker*) omakub-restart-walker ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio") in
  *Audio*) present_terminal omakub-restart-pipewire ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  User") in
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  omakub-launch-about
}

show_system_menu() {
  local options="󰌾  Lock"
  [[ ! -f ~/.local/state/omakub/toggles/suspend-off ]] && options="$options\n󰒲  Suspend"
  options="$options\n󰌾  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Lock*) omakub-system-lock-screen ;;
  *Suspend*) systemctl suspend ;;
  *Logout*) omakub-system-logout ;;
  *Restart*) omakub-system-reboot ;;
  *Shutdown*) omakub-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n󰑐  Update\n  About\n󰤆  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) omakub-menu-app ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *style*) show_style_menu ;;
  *background*) show_background_menu ;;
  *theme*) show_theme_menu ;;
  *setup*) show_setup_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/omakub/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi