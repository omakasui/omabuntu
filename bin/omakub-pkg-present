#!/bin/bash

# omakub:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# omakub:args=<packages...>

for pkg in "$@"; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "^install ok installed" &>/dev/null || exit 1
done

exit 0
