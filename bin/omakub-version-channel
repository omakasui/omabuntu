#!/bin/bash

# omakub:summary=Print the active Omabuntu APT package channel.

_suite() {
  awk '$1 == "Suites:" { print $2; exit }' "/etc/apt/sources.list.d/$1.sources" 2>/dev/null
}

pkgs_suite=$(_suite omakasui)
core_suite=$(_suite omakasui-core)

if [[ $pkgs_suite == $core_suite ]]; then
  if [[ $pkgs_suite == *-dev ]]; then
    echo "dev"
  else
    echo "stable"
  fi
else
  echo "$core_suite / $pkgs_suite"
fi
