#!/bin/bash

# omakub:summary=Update Omabuntu and system packages.
# omakub:args=[-y]
# omakub:examples=omakub update | omakub update -y
# omakub:requires-sudo=true

set -e

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\033[0m"' ERR

if [[ $1 == "-y" ]] || omakub-update-confirm; then
  omakub-update-git
  omakub-update-perform
fi