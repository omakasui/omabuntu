#!/bin/bash

# omakub:summary=Reinstall all default Omabuntu packages from the stable channel.
# omakub:requires-sudo=true

set -e

# Set the package repository to the stable mirrors
omakub-refresh-apt

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMAKUB_PATH/install/omakub-base.packages" | grep -v '^$')
omakub-pkg-add "${packages[@]}"
