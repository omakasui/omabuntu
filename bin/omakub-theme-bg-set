#!/bin/bash

# omakub:summary=Set the current background image.
# omakub:args=<path-to-image> [zoom|center|stretch|fill|fit|spanned]
# omakub:examples=omakub theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: omakub-theme-bg-set <path-to-image> [zoom|center|stretch|fill|fit|spanned]" >&2
  exit 1
fi

BACKGROUND=${1:-'file:///usr/share/backgrounds/warty-final-ubuntu.png'}
ZOOM_FLAG=${2:-'zoom'}

CURRENT_BACKGROUND_LINK="$HOME/.config/omakub/current/background"

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

gsettings set org.gnome.desktop.background picture-uri $CURRENT_BACKGROUND_LINK
gsettings set org.gnome.desktop.background picture-uri-dark $CURRENT_BACKGROUND_LINK
gsettings set org.gnome.desktop.background picture-options $ZOOM_FLAG
