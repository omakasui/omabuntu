#!/bin/bash

# omakub:summary=Ensure the Omakasui keyring packages, which provide the APT signing keys and sources, are installed.
# omakub:requires-sudo=true

echo -e "\e[32m\nUpdate Omakasui signing keys\e[0m"

if omakub-pkg-present omakasui-archive-keyring omakasui-core-archive-keyring; then
  echo "Keyrings up to date, skipping."
  exit 0
fi

codename=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
tmp_dir=$(mktemp -d)
chmod 755 "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT

if ! curl -fsSL -o "$tmp_dir/omakasui-archive-keyring.deb" \
    "https://packages.omakasui.org/omakasui-archive-keyring/$codename.deb" ||
  ! curl -fsSL -o "$tmp_dir/omakasui-core-archive-keyring.deb" \
    "https://core.omakasui.org/omakasui-core-archive-keyring/$codename.deb"; then
  echo "Warning: failed to download the Omakasui keyring packages, skipping."
  exit 0
fi

sudo apt-get install -y "$tmp_dir/omakasui-archive-keyring.deb" "$tmp_dir/omakasui-core-archive-keyring.deb"
