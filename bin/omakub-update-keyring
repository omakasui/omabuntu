#!/bin/bash

# omakub:summary=Ensure the Omakasui keyring packages, which provide the APT signing keys and sources, are installed.
# omakub:args=[--force]
# omakub:requires-sudo=true

echo -e "\e[32m\nUpdate Omakasui signing keys\e[0m"

# --force reinstalls the keyrings built for the running release, e.g. after a release upgrade.
force=false

if [[ $1 == "--force" ]]; then
  force=true
fi

if [[ $force == false ]] && omakub-pkg-present omakasui-archive-keyring omakasui-core-archive-keyring; then
  echo "Keyrings up to date, skipping."
  exit 0
fi

codename=$(omakub-version-codename)
tmp_dir=$(mktemp -d)
chmod 755 "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT

if ! curl -fsSL -o "$tmp_dir/omakasui-archive-keyring.deb" \
    "https://packages.omakasui.org/omakasui-archive-keyring/$codename.deb" ||
  ! curl -fsSL -o "$tmp_dir/omakasui-core-archive-keyring.deb" \
    "https://core.omakasui.org/omakasui-core-archive-keyring/$codename.deb"; then
  echo "Warning: failed to download the Omakasui keyring packages, skipping."
  exit 0
fi

install_options=()

# The shipped sources are conffiles already edited by omakub-refresh-apt: take the
# release's version without prompting, omakub-refresh-apt sets the channel again.
if [[ $force == true ]]; then
  install_options=(--reinstall -o Dpkg::Options::=--force-confnew)
fi

sudo apt-get install -y "${install_options[@]}" "$tmp_dir/omakasui-archive-keyring.deb" "$tmp_dir/omakasui-core-archive-keyring.deb"
