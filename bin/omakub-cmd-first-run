#!/bin/bash

# Finish the installation of Omabuntu with items that can only be done after logging in.

set -e

OMAKUB_PATH="$HOME/.local/share/omakub"
FIRST_RUN_MODE=~/.local/state/omakub/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  bash "$OMAKUB_PATH/install/first-run/firewall.sh"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$OMAKUB_PATH/install/first-run/welcome.sh"
  rm -f "$FIRST_RUN_MODE"
fi
