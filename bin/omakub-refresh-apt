#!/bin/bash

# omakub:summary=Switch the Omakasui APT sources to the given package channel, then update.
# omakub:args=[stable|dev]
# omakub:requires-sudo=true

channel="${1:-stable}"

if [[ $channel != "stable" && $channel != "dev" ]]; then
  echo "Error: Invalid channel '$channel'. Must be one of: stable, dev"
  exit 1
fi

codename=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")

if [[ $channel == "dev" ]]; then
  suite="${codename}-dev"
else
  suite="$codename"
fi

# The sources are shipped by the keyring packages: make sure they are installed.
omakub-update-keyring

if omakub-pkg-missing omakasui-archive-keyring omakasui-core-archive-keyring; then
  echo "Error: the Omakasui keyring packages are not installed"
  exit 1
fi

echo "Setting APT channel to $channel ($suite)"

for sources in /etc/apt/sources.list.d/omakasui.sources /etc/apt/sources.list.d/omakasui-core.sources; do
  sudo sed -i -E "s/^Suites:.*/Suites: $suite/" "$sources"
done

# One-line sources from the old setup would duplicate the ones above.
sudo rm -f /etc/apt/sources.list.d/omakasui.list /etc/apt/sources.list.d/omakasui-core.list

sudo apt-get update
