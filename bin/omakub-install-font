#!/bin/bash

# Install one of the supported fonts. Usually called via Install > Fonts > * in the Omadeb Menu.

if [[ -z $1 ]]; then
  echo "Usage: omadeb-install-font <font>" >&2
  exit 1
fi

mkdir -p ~/.local/share/fonts

case "$1" in
jetbrains-mono)
  echo -e "Installing JetBrains Mono...\n"
  omakub-pkg-add omakasui-font-jetbrains-mono
  ;;
iafonts)
  wget -O iafonts.zip https://github.com/iaolo/iA-Fonts/archive/refs/heads/master.zip
  unzip iafonts.zip -d iaFonts
  cp "iaFonts/iA-Fonts-master/iA Writer Mono/Static"/iAWriterMonoS-*.ttf ~/.local/share/fonts
  rm -rf iafonts.zip iaFonts
  ;;
cascadia-mono)
  echo -e "Installing Cascadia Mono NF...\n"
  omakub-pkg-add omakasui-font-cascadia-mono-nf
  ;;
mscore)
  echo -e "Installing Microsoft Core Fonts...\n"
  omakub-pkg-add ttf-mscorefonts-installer
  ;;
*)
  echo "Usage: omadeb-install-font <font>" >&2
  exit 1
  ;;
esac

fc-cache